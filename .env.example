# 环境变量示例 —— 复制为 .env 并填入真实值（.env 不会提交，也不会进入 npm 包）
#
# CDN/IIFE 构建（npm run build / build:cdn）会通过 Vite define 把 MAISI_API_KEY
# 注入到 KeepworkSDK.API_KEYS.maisi，用于 maisi 项目 /gpt/* 端点鉴权。
# npm 构建（build:npm）不读取本文件，API_KEYS.maisi 注入为空字符串。

MAISI_API_KEY=

# 火山引擎语音 AccessToken（用于 test/*.html 的 RTC / 数字人语音测试）。
# dev server（npm run dev）会通过 /test/env.js 端点把该值注入为
# window.__TEST_SECRETS__.VOLC_ACCESS_TOKEN；本文件不提交、不进 npm 包、不进构建产物。
# 缺失时测试页会回落到占位符（需手动填写）。
VOLC_ACCESS_TOKEN=
