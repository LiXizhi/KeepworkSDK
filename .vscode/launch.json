{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "KeepworkSDK Build",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
            "args": ["build", "--config", "vite.keepworkSDK.config.ts"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "KeepworkSDK Build Watch",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
            "args": ["build", "--config", "vite.keepworkSDK.config.ts", "--watch"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "KeepworkSDK File Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
            "args": ["--config", "vite.keepworkSDK.config.ts", "--host", "0.0.0.0", "--port", "3001"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Debug KeepworkSDK Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3001/test/testKeepworkSDK.html",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "Debug KeepworkSDK Full Stack",
            "configurations": [
                "KeepworkSDK Build Watch",
                "KeepworkSDK File Server",
                "Debug KeepworkSDK Chrome"
            ],
            "stopAll": true
        }
    ]
}
